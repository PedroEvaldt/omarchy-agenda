#!/usr/bin/env python3
"""agenda — a CLI do plugin Agenda para o Omarchy.

Única porta de entrada para os dados: o painel QML, o terminal, o daemon e
(no futuro) o WhatsApp passam por aqui. As tarefas vivem no state.json local;
os eventos vêm do Google Calendar quando ele está configurado, ou ficam
locais quando não está.

Só biblioteca padrão do Python: nada para instalar.

Uso rápido:
    agenda add "pagar luz amanhã"
    agenda add "montar apresentação sex" --sub "rascunho" --sub "slides"
    agenda done 7k2a
    agenda sub done 7k2a.1
    agenda list
    agenda event add "dentista qui 15h-16h30"
    agenda google setup ~/Downloads/client_secret_xxx.json
    agenda sync
    agenda service install
    agenda telegram setup <token-do-botfather>
    agenda seed          # grava dados de exemplo
    agenda parse "texto" # mostra como o texto seria interpretado
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import date, datetime, timedelta

# Os módulos de apoio moram em ../lib, ao lado deste executável.
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

import agenda_bridge as bridge  # noqa: E402
import agenda_daemon as daemon  # noqa: E402
import agenda_google as google  # noqa: E402
import agenda_ops as ops  # noqa: E402
import agenda_store as store  # noqa: E402
import agenda_telegram as telegram  # noqa: E402

# A interpretação de texto mora em agenda_ops; fica visível aqui para quem
# importa este arquivo (os testes, por exemplo).
parse_text = ops.parse_text


def fail(message: str) -> None:
    print(f"agenda: {message}", file=sys.stderr)
    sys.exit(1)


def self_path() -> str:
    return os.path.realpath(__file__)


# ---------------------------------------------------------------------------
# Tarefas
# ---------------------------------------------------------------------------


def cmd_add(args) -> None:
    task = ops.add_task(" ".join(args.text), due=args.due, subs=args.sub or [], priority=True if args.priority else None)
    print(ops.describe_task(task))


def cmd_done(args) -> None:
    print(f"concluída: {ops.complete_task(args.id)['title']}")


def cmd_undo(args) -> None:
    print(f"reaberta: {ops.reopen_task(args.id)['title']}")


def cmd_rm(args) -> None:
    task = ops.delete_task(args.id)
    print(f"excluída: {task['title']} (desfazer: agenda restore {task['id']})")
    store.notify("Tarefa excluída", task["title"], action=("Desfazer", [self_path(), "restore", task["id"]]))


def cmd_restore(args) -> None:
    task = ops.restore_task(args.id)
    print(f"restaurada: {task['title']}")
    store.notify("Tarefa restaurada", task["title"])


def cmd_snooze(args) -> None:
    task = ops.snooze_task(args.id, args.days)
    print(f"adiada para {task['due']}: {task['title']}")


def cmd_edit(args) -> None:
    print(ops.describe_task(ops.edit_task(args.id, title=args.title, due=args.due, no_due=args.no_due, priority=args.priority)))


def cmd_sub(args) -> None:
    if args.sub_command == "add":
        task, sub = ops.add_subtask(args.id, " ".join(args.text))
        print(f"{sub['id']}  {sub['title']}")
    elif args.sub_command == "done":
        print(f"feito: {ops.set_subtask(args.id, True)[1]['title']}")
    elif args.sub_command == "undo":
        print(f"reaberto: {ops.set_subtask(args.id, False)[1]['title']}")
    else:
        print(f"removido: {ops.remove_subtask(args.id)[1]['title']}")


def cmd_list(args) -> None:
    state = store.read_state()
    if args.json:
        print(json.dumps(state, ensure_ascii=False, indent=2))
        return
    printed = False
    for title, tasks in ops.sections(state, date.today(), include_done=args.all):
        printed = True
        print(title)
        for task in tasks:
            box = "[x]" if task.get("completedAt") else "[ ]"
            due = f"  ({task['due']}{' ' + task['dueTime'] if task.get('dueTime') else ''})" if task.get("due") else ""
            print(f"  {box} {task['id']}  {task['title']}{due}")
            for sub in task.get("subtasks", []):
                print(f"        {'[x]' if sub.get('done') else '[ ]'} {sub['id']}  {sub['title']}")
    if not printed:
        print("nada por fazer")


# ---------------------------------------------------------------------------
# Eventos
# ---------------------------------------------------------------------------


def cmd_event(args) -> None:
    if args.event_command == "add":
        event, origin = ops.add_event(" ".join(args.text), local=args.local)
        where = f"Google: {event['calendar']}" if origin == "google" else "local"
        print(f"{event['id']}  {event['title']}  {event['start']}  ({where})")
    elif args.event_command == "rm":
        print(f"evento removido: {ops.remove_event(args.id)['title']}")
    else:
        for event in sorted(store.read_state()["events"], key=lambda e: e.get("start", "")):
            print(f"  {event.get('id')}  {event.get('start')}  {event.get('title')}  [{event.get('calendar', '')}]")


# ---------------------------------------------------------------------------
# Google Calendar
# ---------------------------------------------------------------------------


def cmd_sync(args) -> None:
    if not google.is_configured():
        print("Google não configurado: rode `agenda google setup <client_secret.json>`. Veja docs/google-setup.md.")
        return
    count = google.sync_into_state(google.connect(), google.load_config())
    print(f"sync ok: {count} eventos do Google")


def cmd_google(args) -> None:
    if args.google_command == "setup":
        target = google.install_client_secret(args.client_secret)
        config = google.ensure_config_file()
        print(f"credenciais em {target}\nconfiguração em {config}")
        token = google.authorize(google.load_client(), open_browser=not args.no_browser)
        where = google.TokenStore().save(token)
        print(f"autorizado; token guardado no {where}")
        cmd_sync(args)
    elif args.google_command == "auth":
        google.ensure_config_file()
        token = google.authorize(google.load_client(), open_browser=not args.no_browser)
        where = google.TokenStore().save(token)
        print(f"autorizado; token guardado no {where}")
    elif args.google_command == "calendars":
        for cal in google.connect().calendar_list():
            marker = " (principal)" if cal.get("primary") else ""
            print(f"  {cal.get('id')}  {cal.get('summary')}{marker}")
    elif args.google_command == "logout":
        google.TokenStore().clear()
        print("token apagado; o acesso continua listado em myaccount.google.com/permissions até você revogar lá")
    else:
        configured = google.is_configured()
        state = store.read_state()
        print(f"client_secret: {'ok' if os.path.exists(google.client_secret_path()) else 'falta'}")
        print(f"token: {'ok' if google.TokenStore().load() else 'falta'}")
        print(f"config: {google.config_path()}")
        sync = state["sync"]
        print(f"última sincronização: {sync.get('lastOkAt') or 'nunca'}  estado: {sync.get('status')}  {sync.get('error', '')}".rstrip())
        print(f"serviço agendad: {daemon.service_status()}")
        if not configured:
            print("\nPara configurar: agenda google setup <client_secret.json>")


def cmd_daemon(args) -> None:
    daemon.run(google.load_config(), once=args.once)


def cmd_service(args) -> None:
    if args.service_command == "install":
        try:
            path = daemon.install_service(self_path())
        except RuntimeError as error:
            fail(str(error))
        print(f"serviço instalado em {path} e ligado; logs: journalctl --user -u agendad -f")
    elif args.service_command == "uninstall":
        daemon.uninstall_service()
        print("serviço removido")
    elif args.service_command == "restart":
        result = daemon.systemctl("restart", daemon.SERVICE_NAME)
        if result.returncode != 0:
            fail(f"não reiniciou: {result.stderr.strip()}")
        print(f"reiniciado: {daemon.service_status()}")
    else:
        print(daemon.service_status())


# ---------------------------------------------------------------------------
# Telegram e a ponte de mensagens
# ---------------------------------------------------------------------------


def cmd_telegram(args) -> None:
    if args.telegram_command == "setup":
        chat_id = telegram.pair(args.token)
        path = telegram.save_credentials(args.token, chat_id)
        print(f"pareado com o chat {chat_id}; credenciais em {path}")
        print("reinicie o serviço para ele começar a atender: agenda service restart")
    elif args.telegram_command == "send":
        creds = telegram.load_credentials()
        if not creds or not creds["chat_id"]:
            fail("Telegram não configurado; rode `agenda telegram setup <token>`")
        telegram.Bot(creds["token"], creds["chat_id"]).send(bridge.Reply(" ".join(args.text)))
        print("enviado")
    elif args.telegram_command == "logout":
        if os.path.exists(telegram.credentials_path()):
            os.unlink(telegram.credentials_path())
        print("credenciais do Telegram apagadas; revogue o token no BotFather se quiser")
    else:
        creds = telegram.load_credentials()
        print(f"token: {'ok' if creds else 'falta'}")
        print(f"chat pareado: {creds['chat_id'] if creds and creds['chat_id'] else 'não'}")
        print(f"serviço agendad: {daemon.service_status()}")


def cmd_bridge(args) -> None:
    """Conversa com a ponte no terminal, sem Telegram: útil para testar frases."""
    reply = bridge.handle_text(" ".join(args.text))
    print(reply.text)
    for label, data in reply.buttons:
        print(f"  [{label}] -> {data}")


# ---------------------------------------------------------------------------
# Utilidades
# ---------------------------------------------------------------------------


def cmd_parse(args) -> None:
    parsed = parse_text(" ".join(args.text))
    parsed["due"] = parsed["due"].isoformat() if parsed["due"] else None
    print(json.dumps(parsed, ensure_ascii=False, indent=2))


def cmd_seed(args) -> None:
    """Dados de exemplo relativos a hoje, para ver o painel cheio sem esforço."""
    today = date.today()
    tz = store.now_local().tzinfo

    def at(day: date, hhmm: str) -> str:
        return store.iso(datetime.combine(day, datetime.strptime(hhmm, "%H:%M").time(), tzinfo=tz))

    samples = [
        ("Pagar conta de luz", today - timedelta(days=1), None, 0, []),
        ("Levar exames pro dentista", today, "15:00", 0, []),
        ("Montar apresentação", today, None, 1, ["Rascunho", "Slides", "Revisar texto", "Ensaiar"]),
        ("Presente pra Ana", today + timedelta(days=3), None, 0, ["Escolher", "Comprar", "Embrulhar"]),
        ("Ler sobre Quickshell", None, None, 0, []),
    ]
    with store.locked_state() as state:
        state.update(store.empty_state())
        for title, due, due_time, priority, subs in samples:
            state["tasks"].append(ops.make_task(state, title, due, due_time, priority, subs))
        state["tasks"][2]["subtasks"][0]["done"] = True
        state["tasks"][2]["subtasks"][1]["done"] = True
        done = ops.make_task(state, "Configurar o Omarchy", today - timedelta(days=1), None, 0, [])
        done["completedAt"] = store.iso(store.now_local() - timedelta(hours=3))
        state["tasks"].append(done)

        def ev(num: int, title: str, start: str, end: str, all_day: bool = False, location: str = "", url: str = "") -> dict:
            return {"id": f"l:ev0{num}", "calendar": "local", "calendarId": "", "color": "", "title": title, "allDay": all_day,
                    "start": start, "end": end, "location": location, "url": url, "description": ""}

        state["events"] = [
            ev(1, "Aniversário da Ana", today.isoformat(), (today + timedelta(days=1)).isoformat(), all_day=True),
            ev(2, "Daily", at(today, "09:00"), at(today, "09:30")),
            ev(3, "Dentista", at(today, "15:00"), at(today, "16:00"), location="Centro"),
            ev(4, "Call com cliente", at(today + timedelta(days=1), "14:00"), at(today + timedelta(days=1), "15:00"), url="https://meet.google.com/"),
            ev(5, "Jantar", at(today + timedelta(days=3), "19:30"), at(today + timedelta(days=3), "22:00")),
        ]
    print(f"dados de exemplo gravados em {store.state_path()}")


def cmd_path(args) -> None:
    print(store.state_path())


# ---------------------------------------------------------------------------
# Linha de comando
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="agenda", description="Tarefas e agenda do plugin Agenda para o Omarchy.")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("add", help="cria uma tarefa a partir de texto livre")
    p.add_argument("text", nargs="+")
    p.add_argument("--due", help="prazo: YYYY-MM-DD ou texto como 'amanhã', 'sex', '12/11'")
    p.add_argument("--sub", action="append", help="subpasso (pode repetir)")
    p.add_argument("--priority", action="store_true", help="prioridade alta")
    p.set_defaults(func=cmd_add)

    for name, func, help_text in (
        ("done", cmd_done, "conclui a tarefa e todos os subpassos"),
        ("undo", cmd_undo, "reabre uma tarefa concluída"),
        ("rm", cmd_rm, "exclui a tarefa (vai para a lixeira)"),
        ("restore", cmd_restore, "traz uma tarefa de volta da lixeira"),
    ):
        p = sub.add_parser(name, help=help_text)
        p.add_argument("id")
        p.set_defaults(func=func)

    p = sub.add_parser("snooze", help="adia o prazo em N dias (padrão 1)")
    p.add_argument("id")
    p.add_argument("days", nargs="?", type=int, default=1)
    p.set_defaults(func=cmd_snooze)

    p = sub.add_parser("edit", help="altera título, prazo ou prioridade")
    p.add_argument("id")
    p.add_argument("--title")
    p.add_argument("--due")
    p.add_argument("--no-due", action="store_true")
    p.add_argument("--priority", type=int, choices=[0, 1], default=None)
    p.set_defaults(func=cmd_edit)

    p = sub.add_parser("sub", help="subpassos: add <id> <texto> | done|undo|rm <id.n>")
    sp = p.add_subparsers(dest="sub_command", required=True)
    q = sp.add_parser("add")
    q.add_argument("id")
    q.add_argument("text", nargs="+")
    for name in ("done", "undo", "rm"):
        q = sp.add_parser(name)
        q.add_argument("id")
    p.set_defaults(func=cmd_sub)

    p = sub.add_parser("list", help="lista as tarefas abertas")
    p.add_argument("--json", action="store_true", help="imprime o state.json inteiro")
    p.add_argument("--all", action="store_true", help="inclui as concluídas")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("event", help="eventos: add <texto> [--local] | rm <id> | list")
    ep = p.add_subparsers(dest="event_command", required=True)
    q = ep.add_parser("add")
    q.add_argument("text", nargs="+")
    q.add_argument("--local", action="store_true", help="não manda para o Google mesmo que ele esteja configurado")
    q = ep.add_parser("rm")
    q.add_argument("id")
    ep.add_parser("list")
    p.set_defaults(func=cmd_event)

    sub.add_parser("sync", help="busca os eventos do Google Calendar agora").set_defaults(func=cmd_sync)

    p = sub.add_parser("google", help="Google Calendar: setup <client_secret.json> | auth | status | calendars | logout")
    gp = p.add_subparsers(dest="google_command", required=True)
    q = gp.add_parser("setup")
    q.add_argument("client_secret")
    q.add_argument("--no-browser", action="store_true")
    q = gp.add_parser("auth")
    q.add_argument("--no-browser", action="store_true")
    gp.add_parser("status")
    gp.add_parser("calendars")
    gp.add_parser("logout")
    p.set_defaults(func=cmd_google)

    p = sub.add_parser("daemon", help="roda o agendad em primeiro plano")
    p.add_argument("--once", action="store_true", help="uma volta do laço e sai")
    p.set_defaults(func=cmd_daemon)

    p = sub.add_parser("service", help="serviço do systemd: install | uninstall | restart | status")
    svc = p.add_subparsers(dest="service_command", required=True)
    for name in ("install", "uninstall", "restart", "status"):
        svc.add_parser(name)
    p.set_defaults(func=cmd_service)

    p = sub.add_parser("telegram", help="bot do Telegram: setup <token> | status | send <texto> | logout")
    tp = p.add_subparsers(dest="telegram_command", required=True)
    q = tp.add_parser("setup")
    q.add_argument("token")
    tp.add_parser("status")
    q = tp.add_parser("send")
    q.add_argument("text", nargs="+")
    tp.add_parser("logout")
    p.set_defaults(func=cmd_telegram)

    p = sub.add_parser("bridge", help="manda um texto para a ponte de mensagens e mostra a resposta")
    p.add_argument("text", nargs="+")
    p.set_defaults(func=cmd_bridge)

    p = sub.add_parser("parse", help="mostra como um texto seria interpretado, sem gravar")
    p.add_argument("text", nargs="+")
    p.set_defaults(func=cmd_parse)

    sub.add_parser("seed", help="grava dados de exemplo relativos a hoje").set_defaults(func=cmd_seed)
    sub.add_parser("path", help="imprime o caminho do state.json").set_defaults(func=cmd_path)
    return parser


def main(argv: list[str] | None = None) -> None:
    args = build_parser().parse_args(argv)
    try:
        args.func(args)
    except (ops.OpsError, google.GoogleError, store.StoreError, telegram.TelegramError) as error:
        fail(str(error))
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()

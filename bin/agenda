#!/usr/bin/env python3
"""agenda — a CLI do plugin Agenda para o Omarchy.

Fase 1: as tarefas e os eventos ficam num único arquivo JSON local, o
state.json. O painel QML lê esse arquivo e observa mudanças nele; toda
escrita, venha do painel, do terminal ou (no futuro) do WhatsApp, passa por
aqui. Assim existe uma única porta de entrada para os dados.

Só biblioteca padrão do Python: nada para instalar.

Uso rápido:
    agenda add "pagar luz amanhã"
    agenda add "montar apresentação sex" --sub "rascunho" --sub "slides"
    agenda done 7k2a
    agenda sub done 7k2a.1
    agenda list
    agenda event add "dentista qui 15h-16h30"
    agenda seed          # grava dados de exemplo
    agenda parse "texto" # mostra como o texto seria interpretado
"""

from __future__ import annotations

import argparse
import json
import os
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import unicodedata
from datetime import date, datetime, timedelta

ID_ALPHABET = "0123456789abcdefghijklmnopqrstuvwxyz"
ID_LENGTH = 4
# Concluídas somem do arquivo depois deste prazo; a lixeira também.
RETENTION_DAYS = 7
DEFAULT_EVENT_MINUTES = 60

# ---------------------------------------------------------------------------
# Arquivo de estado
# ---------------------------------------------------------------------------


def state_path() -> str:
    """Caminho do state.json. AGENDA_STATE permite trocar nos testes."""
    override = os.environ.get("AGENDA_STATE")
    if override:
        return override
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "agenda", "state.json")


def now_local() -> datetime:
    return datetime.now().astimezone()


def iso(dt: datetime) -> str:
    return dt.isoformat(timespec="seconds")


def empty_state() -> dict:
    return {
        "version": 1,
        "generatedAt": "",
        "sync": {"lastOkAt": "", "status": "none", "error": ""},
        "tasks": [],
        "events": [],
        "trash": [],
    }


def load_state(path: str) -> dict:
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except FileNotFoundError:
        return empty_state()
    except (OSError, json.JSONDecodeError) as error:
        fail(f"não consegui ler {path}: {error}")
    state = empty_state()
    if isinstance(data, dict):
        for key in ("tasks", "events", "trash"):
            if isinstance(data.get(key), list):
                state[key] = data[key]
        if isinstance(data.get("sync"), dict):
            state["sync"].update(data["sync"])
    return state


def prune(state: dict, now: datetime) -> None:
    """Esquece concluídas e excluídas velhas para o arquivo não crescer para sempre."""
    cutoff = iso(now - timedelta(days=RETENTION_DAYS))
    state["tasks"] = [t for t in state["tasks"] if not t.get("completedAt") or t["completedAt"] >= cutoff]
    state["trash"] = [t for t in state["trash"] if t.get("deletedAt", "") >= cutoff]


def save_state(path: str, state: dict) -> None:
    """Escrita atômica: grava num temporário e troca de lugar com o arquivo real.

    O painel observa o arquivo; sem isso ele poderia ler um JSON pela metade.
    """
    now = now_local()
    prune(state, now)
    state["generatedAt"] = iso(now)
    directory = os.path.dirname(path) or "."
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".state-", suffix=".json", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(state, handle, ensure_ascii=False, indent=2)
            handle.write("\n")
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def fail(message: str) -> None:
    print(f"agenda: {message}", file=sys.stderr)
    sys.exit(1)


# ---------------------------------------------------------------------------
# Identificadores
# ---------------------------------------------------------------------------


def existing_ids(state: dict) -> set[str]:
    ids = set()
    for bucket in ("tasks", "trash"):
        for task in state[bucket]:
            ids.add(task.get("id", ""))
    for event in state["events"]:
        ids.add(event.get("id", ""))
    return ids


def new_id(state: dict) -> str:
    """Quatro caracteres base36: curto o bastante para digitar numa mensagem."""
    taken = existing_ids(state)
    while True:
        candidate = "".join(secrets.choice(ID_ALPHABET) for _ in range(ID_LENGTH))
        if candidate not in taken and candidate[0].isalpha():
            return candidate


def find_task(state: dict, task_id: str) -> dict:
    for task in state["tasks"]:
        if task.get("id") == task_id:
            return task
    fail(f"tarefa '{task_id}' não existe")


def find_sub(state: dict, sub_id: str) -> tuple[dict, dict]:
    task_id, _, _ = sub_id.partition(".")
    task = find_task(state, task_id)
    for sub in task.get("subtasks", []):
        if sub.get("id") == sub_id:
            return task, sub
    fail(f"subpasso '{sub_id}' não existe")


def next_sub_id(task: dict) -> str:
    used = {sub.get("id", "") for sub in task.get("subtasks", [])}
    n = 1
    while f"{task['id']}.{n}" in used:
        n += 1
    return f"{task['id']}.{n}"


# ---------------------------------------------------------------------------
# Interpretação de texto em português
# ---------------------------------------------------------------------------

# Python conta a semana a partir da segunda (0) até o domingo (6).
WEEKDAYS = {
    "segunda": 0, "seg": 0, "segunda-feira": 0,
    "terca": 1, "ter": 1, "terca-feira": 1,
    "quarta": 2, "qua": 2, "quarta-feira": 2,
    "quinta": 3, "qui": 3, "quinta-feira": 3,
    "sexta": 4, "sex": 4, "sexta-feira": 4,
    "sabado": 5, "sab": 5,
    "domingo": 6, "dom": 6,
}
CONNECTORS_BEFORE_DAY = {"na", "no", "nesta", "neste", "nessa", "nesse", "proxima", "proximo", "em"}
CONNECTORS_BEFORE_TIME = {"as", "a", "das"}

TIME_RE = re.compile(r"^(\d{1,2})(?:h|:)(\d{2})?$")
RANGE_RE = re.compile(r"^(\d{1,2})(?:h|:)?(\d{2})?-(\d{1,2})(?:h|:)?(\d{2})?$")
DATE_RE = re.compile(r"^(\d{1,2})/(\d{1,2})(?:/(\d{2,4}))?$")


def strip_accents(text: str) -> str:
    decomposed = unicodedata.normalize("NFD", text)
    return "".join(ch for ch in decomposed if unicodedata.category(ch) != "Mn")


def clean_token(raw: str) -> str:
    return strip_accents(raw.lower()).strip(",.;")


def valid_time(hour: str, minute: str | None) -> str | None:
    h = int(hour)
    m = int(minute) if minute else 0
    if 0 <= h <= 23 and 0 <= m <= 59:
        return f"{h:02d}:{m:02d}"
    return None


def resolve_day_of_month(day: int, today: date) -> date | None:
    """'dia 12' é o dia 12 deste mês, ou do próximo se já passou."""
    for months_ahead in (0, 1):
        year = today.year + (today.month - 1 + months_ahead) // 12
        month = (today.month - 1 + months_ahead) % 12 + 1
        try:
            candidate = date(year, month, day)
        except ValueError:
            continue
        if candidate >= today:
            return candidate
    return None


def resolve_slash_date(match: re.Match, today: date) -> date | None:
    day, month, year = int(match.group(1)), int(match.group(2)), match.group(3)
    try:
        if year:
            y = int(year)
            if y < 100:
                y += 2000
            return date(y, month, day)
        candidate = date(today.year, month, day)
        if candidate < today:
            candidate = date(today.year + 1, month, day)
        return candidate
    except ValueError:
        return None


def parse_text(text: str, today: date | None = None) -> dict:
    """Separa o título das pistas de data e hora.

    "pagar luz amanhã"        -> título "pagar luz", prazo amanhã
    "dentista qui 15h"        -> título "dentista", quinta, 15:00
    "dentista qui 15h-16h30"  -> idem, com fim 16:30
    "relatório sex !"         -> prioridade alta
    """
    today = today or date.today()
    tokens = text.split()
    result = {"title": "", "due": None, "time": None, "endTime": None, "priority": 0}
    keep: list[str] = []
    i = 0
    while i < len(tokens):
        raw = tokens[i]
        tok = clean_token(raw)
        nxt = clean_token(tokens[i + 1]) if i + 1 < len(tokens) else ""

        if tok == "!":
            result["priority"] = 1
            i += 1
            continue
        if tok.endswith("!") and len(tok) > 1:
            result["priority"] = 1
            tok = tok[:-1]
            raw = raw.rstrip("!")

        # Conectivos só somem quando o que vem depois é mesmo uma data ou hora.
        if tok in CONNECTORS_BEFORE_DAY and (nxt in WEEKDAYS or nxt in ("hoje", "amanha") or DATE_RE.match(nxt)):
            i += 1
            continue
        if tok in CONNECTORS_BEFORE_TIME and (TIME_RE.match(nxt) or RANGE_RE.match(nxt)):
            i += 1
            continue

        if tok == "hoje":
            result["due"] = today
        elif tok == "amanha":
            result["due"] = today + timedelta(days=1)
        elif tok == "depois" and nxt == "de" and i + 2 < len(tokens) and clean_token(tokens[i + 2]) == "amanha":
            result["due"] = today + timedelta(days=2)
            i += 2
        elif tok in WEEKDAYS:
            delta = (WEEKDAYS[tok] - today.weekday()) % 7
            result["due"] = today + timedelta(days=delta)
        elif tok == "dia" and nxt.isdigit() and 1 <= int(nxt) <= 31:
            resolved = resolve_day_of_month(int(nxt), today)
            if resolved:
                result["due"] = resolved
                i += 1
            else:
                keep.append(raw)
        elif DATE_RE.match(tok):
            resolved = resolve_slash_date(DATE_RE.match(tok), today)
            if resolved:
                result["due"] = resolved
            else:
                keep.append(raw)
        elif RANGE_RE.match(tok):
            m = RANGE_RE.match(tok)
            start = valid_time(m.group(1), m.group(2))
            end = valid_time(m.group(3), m.group(4))
            if start and end:
                result["time"], result["endTime"] = start, end
            else:
                keep.append(raw)
        elif TIME_RE.match(tok):
            m = TIME_RE.match(tok)
            parsed = valid_time(m.group(1), m.group(2))
            if parsed:
                result["time"] = parsed
            else:
                keep.append(raw)
        else:
            keep.append(raw)
        i += 1

    result["title"] = " ".join(keep).strip(" ,.;")
    return result


def parse_due_option(value: str, today: date) -> date | None:
    """--due aceita tanto 'YYYY-MM-DD' quanto a mesma linguagem do texto livre."""
    try:
        return date.fromisoformat(value)
    except ValueError:
        parsed = parse_text(value, today)
        return parsed["due"]


# ---------------------------------------------------------------------------
# Notificações do Omarchy (opcionais)
# ---------------------------------------------------------------------------


def notify(title: str, body: str = "", action: tuple[str, list[str]] | None = None) -> None:
    """Usa o omarchy-notification-send quando ele existe; fora do Omarchy, silêncio."""
    if os.environ.get("AGENDA_NO_NOTIFY") or not shutil.which("omarchy-notification-send"):
        return
    command = ["omarchy-notification-send", "-g", "󰄲", title, body]
    if action:
        label, program = action
        command += ["--action", label, *program]
    try:
        subprocess.run(command, check=False, timeout=5, capture_output=True)
    except (OSError, subprocess.SubprocessError):
        pass


def self_path() -> str:
    return os.path.realpath(__file__)


# ---------------------------------------------------------------------------
# Tarefas
# ---------------------------------------------------------------------------


def make_task(state: dict, title: str, due: date | None, due_time: str | None, priority: int, subs: list[str]) -> dict:
    task = {
        "id": new_id(state),
        "title": title,
        "due": due.isoformat() if due else "",
        "dueTime": due_time or "",
        "priority": priority,
        "createdAt": iso(now_local()),
        "completedAt": "",
        "subtasks": [],
    }
    for sub_title in subs:
        sub_title = sub_title.strip()
        if sub_title:
            task["subtasks"].append({"id": next_sub_id(task), "title": sub_title, "done": False})
    return task


def describe_task(task: dict) -> str:
    bits = [task["id"], task["title"]]
    if task.get("due"):
        bits.append(task["due"] + (" " + task["dueTime"] if task.get("dueTime") else ""))
    if task.get("priority"):
        bits.append("!")
    return "  ".join(bits)


def cmd_add(args) -> None:
    path = state_path()
    state = load_state(path)
    parsed = parse_text(" ".join(args.text))
    if parsed["title"] == "":
        fail("a tarefa precisa de um título")
    due = parsed["due"]
    if args.due:
        due = parse_due_option(args.due, date.today())
        if due is None:
            fail(f"não entendi o prazo '{args.due}'")
    priority = 1 if args.priority else parsed["priority"]
    task = make_task(state, parsed["title"], due, parsed["time"], priority, args.sub or [])
    state["tasks"].append(task)
    save_state(path, state)
    print(describe_task(task))


def cmd_done(args) -> None:
    path = state_path()
    state = load_state(path)
    task = find_task(state, args.id)
    task["completedAt"] = iso(now_local())
    for sub in task.get("subtasks", []):
        sub["done"] = True
    save_state(path, state)
    print(f"concluída: {task['title']}")


def cmd_undo(args) -> None:
    path = state_path()
    state = load_state(path)
    task = find_task(state, args.id)
    task["completedAt"] = ""
    save_state(path, state)
    print(f"reaberta: {task['title']}")


def cmd_rm(args) -> None:
    path = state_path()
    state = load_state(path)
    task = find_task(state, args.id)
    state["tasks"] = [t for t in state["tasks"] if t is not task]
    task["deletedAt"] = iso(now_local())
    state["trash"].append(task)
    save_state(path, state)
    print(f"excluída: {task['title']} (desfazer: agenda restore {task['id']})")
    notify("Tarefa excluída", task["title"], ("Desfazer", [self_path(), "restore", task["id"]]))


def cmd_restore(args) -> None:
    path = state_path()
    state = load_state(path)
    for task in state["trash"]:
        if task.get("id") == args.id:
            state["trash"].remove(task)
            task.pop("deletedAt", None)
            state["tasks"].append(task)
            save_state(path, state)
            print(f"restaurada: {task['title']}")
            notify("Tarefa restaurada", task["title"])
            return
    fail(f"'{args.id}' não está na lixeira")


def cmd_snooze(args) -> None:
    path = state_path()
    state = load_state(path)
    task = find_task(state, args.id)
    base = date.fromisoformat(task["due"]) if task.get("due") else date.today()
    if base < date.today():
        base = date.today()
    task["due"] = (base + timedelta(days=args.days)).isoformat()
    save_state(path, state)
    print(f"adiada para {task['due']}: {task['title']}")


def cmd_edit(args) -> None:
    path = state_path()
    state = load_state(path)
    task = find_task(state, args.id)
    if args.title:
        task["title"] = args.title.strip()
    if args.no_due:
        task["due"], task["dueTime"] = "", ""
    elif args.due:
        parsed = parse_text(args.due, date.today())
        due = parsed["due"]
        if due is None:
            try:
                due = date.fromisoformat(args.due)
            except ValueError:
                fail(f"não entendi o prazo '{args.due}'")
        task["due"] = due.isoformat()
        if parsed["time"]:
            task["dueTime"] = parsed["time"]
    if args.priority is not None:
        task["priority"] = 1 if args.priority else 0
    save_state(path, state)
    print(describe_task(task))


def cmd_sub(args) -> None:
    path = state_path()
    state = load_state(path)
    if args.sub_command == "add":
        task = find_task(state, args.id)
        title = " ".join(args.text).strip()
        if not title:
            fail("o subpasso precisa de um título")
        sub = {"id": next_sub_id(task), "title": title, "done": False}
        task.setdefault("subtasks", []).append(sub)
        save_state(path, state)
        print(f"{sub['id']}  {sub['title']}")
        return
    task, sub = find_sub(state, args.id)
    if args.sub_command == "done":
        sub["done"] = True
        print(f"feito: {sub['title']}")
    elif args.sub_command == "undo":
        sub["done"] = False
        print(f"reaberto: {sub['title']}")
    elif args.sub_command == "rm":
        task["subtasks"] = [s for s in task["subtasks"] if s is not sub]
        print(f"removido: {sub['title']}")
    save_state(path, state)


SECTION_TITLES = [("overdue", "Atrasadas"), ("today", "Hoje"), ("soon", "Em breve"), ("nodate", "Sem data"), ("done", "Concluídas")]


def classify(task: dict, today: date) -> str:
    if task.get("completedAt"):
        return "done"
    if not task.get("due"):
        return "nodate"
    diff = (date.fromisoformat(task["due"]) - today).days
    if diff < 0:
        return "overdue"
    if diff == 0:
        return "today"
    return "soon"


def cmd_list(args) -> None:
    state = load_state(state_path())
    if args.json:
        print(json.dumps(state, ensure_ascii=False, indent=2))
        return
    today = date.today()
    buckets: dict[str, list[dict]] = {key: [] for key, _ in SECTION_TITLES}
    for task in state["tasks"]:
        buckets[classify(task, today)].append(task)
    printed = False
    for key, title in SECTION_TITLES:
        tasks = buckets[key]
        if not tasks or (key == "done" and not args.all):
            continue
        printed = True
        print(f"{title}")
        for task in sorted(tasks, key=lambda t: (t.get("due") or "9999", t.get("dueTime") or "99", -int(t.get("priority") or 0))):
            box = "[x]" if task.get("completedAt") else "[ ]"
            due = f"  ({task['due']}{' ' + task['dueTime'] if task.get('dueTime') else ''})" if task.get("due") else ""
            print(f"  {box} {task['id']}  {task['title']}{due}")
            for sub in task.get("subtasks", []):
                print(f"        {'[x]' if sub.get('done') else '[ ]'} {sub['id']}  {sub['title']}")
    if not printed:
        print("nada por fazer")


# ---------------------------------------------------------------------------
# Eventos locais (até o Google Calendar entrar na fase 2)
# ---------------------------------------------------------------------------


def cmd_event(args) -> None:
    path = state_path()
    state = load_state(path)
    if args.event_command == "add":
        parsed = parse_text(" ".join(args.text))
        if parsed["title"] == "":
            fail("o evento precisa de um título")
        day = parsed["due"] or date.today()
        event = {
            "id": "l:" + new_id(state),
            "calendar": "local",
            "color": "",
            "title": parsed["title"],
            "location": "",
            "url": "",
            "description": "",
        }
        if parsed["time"]:
            tz = now_local().tzinfo
            start = datetime.combine(day, datetime.strptime(parsed["time"], "%H:%M").time(), tzinfo=tz)
            if parsed["endTime"]:
                end = datetime.combine(day, datetime.strptime(parsed["endTime"], "%H:%M").time(), tzinfo=tz)
                if end <= start:
                    end += timedelta(days=1)
            else:
                end = start + timedelta(minutes=DEFAULT_EVENT_MINUTES)
            event.update({"allDay": False, "start": iso(start), "end": iso(end)})
        else:
            event.update({"allDay": True, "start": day.isoformat(), "end": (day + timedelta(days=1)).isoformat()})
        state["events"].append(event)
        save_state(path, state)
        print(f"{event['id']}  {event['title']}  {event['start']}")
    elif args.event_command == "rm":
        before = len(state["events"])
        state["events"] = [e for e in state["events"] if e.get("id") != args.id]
        if len(state["events"]) == before:
            fail(f"evento '{args.id}' não existe")
        save_state(path, state)
        print("evento removido")
    else:
        for event in sorted(state["events"], key=lambda e: e.get("start", "")):
            print(f"  {event.get('id')}  {event.get('start')}  {event.get('title')}")


# ---------------------------------------------------------------------------
# Utilidades
# ---------------------------------------------------------------------------


def cmd_parse(args) -> None:
    parsed = parse_text(" ".join(args.text))
    parsed["due"] = parsed["due"].isoformat() if parsed["due"] else None
    print(json.dumps(parsed, ensure_ascii=False, indent=2))


def cmd_seed(args) -> None:
    """Dados de exemplo relativos a hoje, para ver o painel cheio sem esforço."""
    path = state_path()
    state = empty_state()
    today = date.today()
    tz = now_local().tzinfo

    def at(day: date, hhmm: str) -> str:
        return iso(datetime.combine(day, datetime.strptime(hhmm, "%H:%M").time(), tzinfo=tz))

    samples = [
        ("Pagar conta de luz", today - timedelta(days=1), None, 0, []),
        ("Levar exames pro dentista", today, "15:00", 0, []),
        ("Montar apresentação", today, None, 1, ["Rascunho", "Slides", "Revisar texto", "Ensaiar"]),
        ("Presente pra Ana", today + timedelta(days=3), None, 0, ["Escolher", "Comprar", "Embrulhar"]),
        ("Ler sobre Quickshell", None, None, 0, []),
    ]
    for title, due, due_time, priority, subs in samples:
        task = make_task(state, title, due, due_time, priority, subs)
        state["tasks"].append(task)
    state["tasks"][2]["subtasks"][0]["done"] = True
    state["tasks"][2]["subtasks"][1]["done"] = True
    done = make_task(state, "Configurar o Omarchy", today - timedelta(days=1), None, 0, [])
    done["completedAt"] = iso(now_local() - timedelta(hours=3))
    state["tasks"].append(done)

    state["events"] = [
        {"id": "l:ev01", "calendar": "local", "color": "", "title": "Aniversário da Ana", "allDay": True,
         "start": today.isoformat(), "end": (today + timedelta(days=1)).isoformat(), "location": "", "url": "", "description": ""},
        {"id": "l:ev02", "calendar": "local", "color": "", "title": "Daily", "allDay": False,
         "start": at(today, "09:00"), "end": at(today, "09:30"), "location": "", "url": "", "description": ""},
        {"id": "l:ev03", "calendar": "local", "color": "", "title": "Dentista", "allDay": False,
         "start": at(today, "15:00"), "end": at(today, "16:00"), "location": "Centro", "url": "", "description": ""},
        {"id": "l:ev04", "calendar": "local", "color": "", "title": "Call com cliente", "allDay": False,
         "start": at(today + timedelta(days=1), "14:00"), "end": at(today + timedelta(days=1), "15:00"),
         "location": "", "url": "https://meet.google.com/", "description": ""},
        {"id": "l:ev05", "calendar": "local", "color": "", "title": "Jantar", "allDay": False,
         "start": at(today + timedelta(days=3), "19:30"), "end": at(today + timedelta(days=3), "22:00"),
         "location": "", "url": "", "description": ""},
    ]
    save_state(path, state)
    print(f"dados de exemplo gravados em {path}")


def cmd_path(args) -> None:
    print(state_path())


# ---------------------------------------------------------------------------
# Linha de comando
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="agenda", description="Tarefas e agenda do plugin Agenda para o Omarchy.")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("add", help="cria uma tarefa a partir de texto livre")
    p.add_argument("text", nargs="+")
    p.add_argument("--due", help="prazo: YYYY-MM-DD ou texto como 'amanhã', 'sex', '12/11'")
    p.add_argument("--sub", action="append", help="subpasso (pode repetir)")
    p.add_argument("--priority", action="store_true", help="prioridade alta")
    p.set_defaults(func=cmd_add)

    for name, func, help_text in (
        ("done", cmd_done, "conclui a tarefa e todos os subpassos"),
        ("undo", cmd_undo, "reabre uma tarefa concluída"),
        ("rm", cmd_rm, "exclui a tarefa (vai para a lixeira)"),
        ("restore", cmd_restore, "traz uma tarefa de volta da lixeira"),
    ):
        p = sub.add_parser(name, help=help_text)
        p.add_argument("id")
        p.set_defaults(func=func)

    p = sub.add_parser("snooze", help="adia o prazo em N dias (padrão 1)")
    p.add_argument("id")
    p.add_argument("days", nargs="?", type=int, default=1)
    p.set_defaults(func=cmd_snooze)

    p = sub.add_parser("edit", help="altera título, prazo ou prioridade")
    p.add_argument("id")
    p.add_argument("--title")
    p.add_argument("--due")
    p.add_argument("--no-due", action="store_true")
    p.add_argument("--priority", type=int, choices=[0, 1], default=None)
    p.set_defaults(func=cmd_edit)

    p = sub.add_parser("sub", help="subpassos: add <id> <texto> | done|undo|rm <id.n>")
    sp = p.add_subparsers(dest="sub_command", required=True)
    q = sp.add_parser("add")
    q.add_argument("id")
    q.add_argument("text", nargs="+")
    for name in ("done", "undo", "rm"):
        q = sp.add_parser(name)
        q.add_argument("id")
    p.set_defaults(func=cmd_sub)

    p = sub.add_parser("list", help="lista as tarefas abertas")
    p.add_argument("--json", action="store_true", help="imprime o state.json inteiro")
    p.add_argument("--all", action="store_true", help="inclui as concluídas")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("event", help="eventos locais: add <texto> | rm <id> | list")
    ep = p.add_subparsers(dest="event_command", required=True)
    q = ep.add_parser("add")
    q.add_argument("text", nargs="+")
    q = ep.add_parser("rm")
    q.add_argument("id")
    ep.add_parser("list")
    p.set_defaults(func=cmd_event)

    p = sub.add_parser("parse", help="mostra como um texto seria interpretado, sem gravar")
    p.add_argument("text", nargs="+")
    p.set_defaults(func=cmd_parse)

    sub.add_parser("seed", help="grava dados de exemplo relativos a hoje").set_defaults(func=cmd_seed)
    sub.add_parser("path", help="imprime o caminho do state.json").set_defaults(func=cmd_path)
    return parser


def main(argv: list[str] | None = None) -> None:
    args = build_parser().parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()
